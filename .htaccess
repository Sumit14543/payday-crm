# Production Main API Reverse Proxy - Port 8081
DirectoryIndex disabled
Options -Indexes
ErrorDocument 403 "Access Forbidden"
ErrorDocument 404 "Not Found"

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to hidden files and directories (including .env, .git, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # 2. Block sensitive file extensions from direct web access
    RewriteRule \.(env|env\..*|json|log|err|sql|bak|yml|yaml|md|lock|sh|key|conf)$ - [F,NC,L]

    # 3. Block internal server directories from web access
    RewriteRule ^(database|config|controllers|models|middleware|services|utils|backups|scratch|tmp|tests|node_modules)(/|$) - [F,NC,L]

    # 4. Proxy ALL other requests to the Node.js backend on port 8081
    RewriteRule ^(.*)$ http://127.0.0.1:8081/$1 [P,L]
</IfModule>

# Defense-in-depth: Deny access to sensitive files even if mod_rewrite is bypassed
<IfModule mod_authz_core.c>
    <FilesMatch "(^\.|\.(env|json|log|err|sql|bak|yml|yaml|md|lock|sh|key|conf)$)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(^\.|\.(env|json|log|err|sql|bak|yml|yaml|md|lock|sh|key|conf)$)">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>
