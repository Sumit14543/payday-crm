NODE_ENV=production
PORT=8080

DB_HOST=your-production-db-host
DB_PORT=3306
DB_NAME=your-production-db-name
DB_USER=your-production-db-user
DB_PASS=your-production-db-password
DB_AUTO_CREATE=false

CORS_ORIGIN=https://payday.waqtmoney.com
PUBLIC_API_URL=https://payday-api.waqtmoney.com
PUBLIC_APP_URL=https://payday.waqtmoney.com
UPLOADS_DIR=./uploads

AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
INTEGRATION_API_KEYS=waqtfinance:replace-with-finance-integration-key,waqtmoney:replace-with-money-integration-key
INTEGRATION_STATUS_WEBHOOK_URLS=waqtmoney:https://waqtmoney.com/api/crm-webhooks/lead-status
INTEGRATION_STATUS_WEBHOOK_SECRETS=waqtmoney:replace-with-webhook-hmac-secret
INTEGRATION_STATUS_WEBHOOK_TIMEOUT_MS=5000
# Generate with:
# npm run generate-auth-user -- telecaller@waqtfinance.com "Waqt Telecaller" telecaller "strong-password"
APP_USERS_JSON=[{"email":"telecaller@waqtfinance.com","name":"Waqt Telecaller","role":"telecaller","salt":"hex-salt","hash":"hex-hash"}]

BIFROST_API_URL=https://bifrost.unifers.ai/enrich/get-cibil-report
BIFROST_AADHAAR_API_URL=https://bifrost.unifers.ai/enrich/get-aadhaar-data
BIFROST_API_TOKEN=your-bifrost-token
BIFROST_AUTH_SCHEME=
BIFROST_CALLBACK_URL=https://payday-api.waqtmoney.com/api/score-callback
BIFROST_TIMEOUT_MS=90000
CIBIL_PENDING_RETRY_AFTER_MS=120000

# Digitap Credit Analytics API Provider
DIGITAP_API_URL=https://svc.digitap.ai/credit_analytics/cf
DIGITAP_CLIENT_ID=your-digitap-client-id
DIGITAP_CLIENT_SECRET=your-digitap-client-secret
DIGITAP_TIMEOUT_MS=90000

OPENAI_API_KEY=your-openai-key
OPENAI_CIBIL_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=90000

SMTP_HOST=your-smtp-host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-from-email
SMTP_FROM_NAME="Waqt Finance"

# GeetPay & Telecaller OTP SMTP
GEETPAY_SMTP_HOST=smtp.hostinger.com
GEETPAY_SMTP_PORT=465
GEETPAY_SMTP_SECURE=true
GEETPAY_SMTP_USERNAME=your-geetpay-smtp-user
GEETPAY_SMTP_PASSWORD=your-geetpay-smtp-pass
GEETPAY_SMTP_FROM_EMAIL=sanction@geetpay.in
GEETPAY_SMTP_FROM_NAME="GeetPay"

TELECALLER_OTP_SMTP_HOST=smtp.hostinger.com
TELECALLER_OTP_SMTP_PORT=465
TELECALLER_OTP_SMTP_SECURE=true
TELECALLER_OTP_SMTP_USERNAME=your-support-smtp-user
TELECALLER_OTP_SMTP_PASSWORD=your-support-smtp-pass
TELECALLER_OTP_SMTP_FROM_EMAIL=support@waqtmoney.in
TELECALLER_OTP_SMTP_FROM_NAME="Waqt CRM Security"

AUTH_KEY=your-authkey-io-auth-key
AUTHKEY_COUNTRY_CODE=91
AUTHKEY_DOCUMENT_UPLOAD_TEMPLATE_ID=35201
AUTHKEY_DOCUMENT_UPLOAD_TEMPLATE_NAME=document_upload_link
AUTHKEY_SANCTION_LETTER_TEMPLATE_ID=35026
AUTHKEY_DIGIO_ESIGN_TEMPLATE_ID=35028

ESIGN_PROVIDER=digio
DIGIO_ENVIRONMENT=production
DIGIO_API_BASE_URL=https://api.digio.in
DIGIO_CLIENT_ID=your-digio-client-id
DIGIO_CLIENT_SECRET=your-digio-client-secret
DIGIO_SIGN_TYPE=AADHAAR
DIGIO_NOTIFY_SIGNER=true
DIGIO_WEBHOOK_URL=https://payday-api.waqtmoney.com/api/digio/webhook
DIGIO_REDIRECT_URL=https://payday.waqtmoney.com

# Cashfree eMandate Configurations
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=PROD
CASHFREE_ALLOWED_ORIGIN=https://payday.waqtmoney.com
CASHFREE_RETURN_URL=https://payday.waqtmoney.com/emandate/pay/{application_id}
CASHFREE_NOTIFY_URL=https://payday-api.waqtmoney.com/api/cashfree/webhook
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# CRIF Account Aggregator Configurations
CRIF_BASE_URL=https://orch.crif.com/orchestrator
CRIF_API_USER=your-crif-api-user
CRIF_API_PASSWORD=your-crif-api-password
CRIF_TEMPLATE_CODE=CT003
CRIF_FLOW_ID=F001
CRIF_REDIRECT_URL=https://payday.waqtmoney.com/account-aggregator/callback

# BillDesk eMandate Configurations
BILLDESK_CLIENT_ID=your-billdesk-client-id
BILLDESK_MERC_ID=your-billdesk-merc-id
BILLDESK_ENCRYPTION_KEY=your-billdesk-encryption-key
BILLDESK_ENCRYPTION_KEY_ID=your-billdesk-enc-key-id
BILLDESK_SIGNING_KEY=your-billdesk-signing-key
BILLDESK_SIGNING_KEY_ID=your-billdesk-sign-key-id
BILLDESK_ENV=production
BILLDESK_PROD_URL=https://api.billdesk.com
BILLDESK_SANDBOX_URL=https://uat1.billdesk.com/u2
