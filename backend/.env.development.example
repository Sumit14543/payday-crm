OPENAI_API_KEY=
OPENAI_CIBIL_MODEL=gpt-4.1
OPENAI_TIMEOUT_MS=90000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Waqt Finance"

ESIGN_PROVIDER=dummy
