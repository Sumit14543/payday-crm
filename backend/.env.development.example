NODE_ENV=development
PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=payday_loan_crm
DB_USER=root
DB_PASS=
DB_AUTO_CREATE=true

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PUBLIC_APP_URL=http://localhost:5173
UPLOADS_DIR=./uploads

AUTH_TOKEN_SECRET=change-this-to-a-long-random-secret
INTEGRATION_API_KEYS=waqtfinance:local-finance-secret,waqtmoney:local-money-secret
