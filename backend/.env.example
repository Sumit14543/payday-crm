NODE_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=payday_loan_crm
DB_USER=root
DB_PASS=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PUBLIC_API_URL=http://localhost:8080
AUTH_TOKEN_SECRET=change-this-to-a-long-random-secret
# Source websites call /api/integrations/leads with x-integration-api-key.
# Format can be a simple comma-separated key list, or source-specific entries:
# INTEGRATION_API_KEYS=waqtfinance:finance-secret,waqtmoney:money-secret
INTEGRATION_API_KEYS=
# Optional: CRM pushes customer-visible status updates to source websites.
# Format: sourceSystem:https://source-site.example/api/crm-webhooks/lead-status
INTEGRATION_STATUS_WEBHOOK_URLS=
# Optional HMAC secrets used for x-crm-webhook-signature. Same source:value format.
INTEGRATION_STATUS_WEBHOOK_SECRETS=
INTEGRATION_STATUS_WEBHOOK_TIMEOUT_MS=5000
# Production must provide users here. Generate entries with:
# npm run generate-auth-user -- telecaller@waqtfinance.com "Waqt Telecaller" telecaller "strong-password"
# APP_USERS_JSON=[{"email":"telecaller@waqtfinance.com","name":"Waqt Telecaller","role":"telecaller","salt":"hex-salt","hash":"hex-hash"}]

# Hosted MySQL users usually cannot create databases from the app.
# Set true only for a local/admin MySQL user that has CREATE DATABASE permission.
DB_AUTO_CREATE=false

BIFROST_API_URL=
BIFROST_AADHAAR_API_URL=https://bifrost.unifers.ai/enrich/get-aadhaar-data
BIFROST_API_TOKEN=
BIFROST_AUTH_SCHEME=
BIFROST_CALLBACK_URL=http://localhost:8080/api/score-callback
BIFROST_TIMEOUT_MS=90000
CIBIL_PENDING_RETRY_AFTER_MS=120000

# Digitap Credit Analytics API (CIBIL Provider)
# UAT: https://svcdemo.digitap.work/credit_analytics/cf
# Production: https://svc.digitap.ai/credit_analytics/cf
DIGITAP_API_URL=https://svcdemo.digitap.work/credit_analytics/cf
DIGITAP_CLIENT_ID=
DIGITAP_CLIENT_SECRET=
DIGITAP_TIMEOUT_MS=90000

# OpenAI is used to extract structured credit observations from the CIBIL PDF.
# Never commit a real key. Put your live key only in backend/.env.
OPENAI_API_KEY=
OPENAI_CIBIL_MODEL=gpt-4.1
OPENAI_TIMEOUT_MS=90000

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Waqt Finance"

AUTH_KEY=
AUTHKEY_COUNTRY_CODE=91
AUTHKEY_DOCUMENT_UPLOAD_TEMPLATE_ID=35201
AUTHKEY_DOCUMENT_UPLOAD_TEMPLATE_NAME=document_upload_link
AUTHKEY_SANCTION_LETTER_TEMPLATE_ID=35026

# eSign provider: dummy for local testing, digio for real loan agreement signing.
ESIGN_PROVIDER=dummy
PUBLIC_APP_URL=http://localhost:5173
UPLOADS_DIR=./uploads
DIGIO_ENVIRONMENT=test
# Test/sandbox credentials use https://ext.digio.in:444.
# Production credentials use https://api.digio.in.
DIGIO_API_BASE_URL=https://ext.digio.in:444
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_SIGN_TYPE=AADHAAR
DIGIO_NOTIFY_SIGNER=true
DIGIO_WEBHOOK_URL=
DIGIO_REDIRECT_URL=

# CRIF Account Aggregator Configurations
CRIF_BASE_URL=https://orch.crif.com/orchestrator
CRIF_API_USER=
CRIF_API_PASSWORD=
CRIF_TEMPLATE_CODE=CT003
CRIF_FLOW_ID=F001
CRIF_REDIRECT_URL=https://testing.waqtmoney.com/account-aggregator/callback

